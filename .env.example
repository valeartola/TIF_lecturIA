# LecturIA — variables de entorno
# Copiá este archivo como .env y completá los valores

DATABASE_URL=sqlite:///./lecturia.db

# Clave para firmar los JWT (obligatoria). Generá una aleatoria, por ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar_por_una_clave_aleatoria

# APIs de IA
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Opcional: el juez de la UM fue reemplazado por Gemini. Dejar vacío si no se usa.
UM_CLOUD_API_KEY=

LOG_LEVEL=INFO
MAX_REINTENTOS_POR_SLOT=3
MAX_REEMPLAZOS_ACTIVIDAD=5